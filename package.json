{
	"name": "osm-reviewer",
	"private": true,
	"version": "0.9.3",
	"type": "module",
	"description": "Review queue for OSM POI candidates found by the extraction pipeline.",
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "vite-node src/lib/server/db/seed.ts"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/leaflet": "^1.9.22",
		"@typescript/native": "npm:typescript@7",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^30.1.0",
		"oauth2-mock-server": "^9.2.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-node": "^6.0.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"leaflet": "^1.9.4",
		"openid-client": "^6.8.8",
		"sveltekit-superforms": "^2.30.2",
		"zod": "^4.6.5"
	}
}

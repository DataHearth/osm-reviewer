# SQLite database. WAL is on, so the directory must be writable, not just the file.
DATABASE_PATH=./data/osm-reviewer.db

# adapter-node (production build only; `pnpm dev` ignores these).
HOST=0.0.0.0
PORT=3000
# The address reviewers open. Form posts are checked against it, and the session cookie
# is Secure only when it is https.
ORIGIN=http://localhost:3000
# Behind a TLS-terminating proxy, have adapter-node read the scheme from this header,
# or the session cookie is never marked Secure.
# PROTOCOL_HEADER=x-forwarded-proto
# BODY_SIZE_LIMIT=512K

# The first admin, created at boot only while the users table is empty. In dev, the seed
# applies these to the fixture admin instead.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# OpenID Connect sign-in. Off until SSO_ISSUER is set; SSO_ENABLED=false turns it off
# even then. The provider must allow <ORIGIN>/login/callback as a redirect URI.
SSO_ISSUER=
# SSO_ENABLED=true
# The name on the "continue with …" button.
SSO_PROVIDER=SSO
SSO_CLIENT_ID=osm-reviewer
# Sent with HTTP Basic auth. Leave empty for a public client, which PKCE alone protects.
SSO_CLIENT_SECRET=
SSO_SCOPES=openid profile email groups
# Required in the `groups` claim on every SSO sign-in. Empty lets any account at the
# provider in.
SSO_GROUP=osm-reviewers

# Shown in the diagnostics pane. The packaging sets these — the Nix package and the
# Dockerfile the commit, the Nix image and the chart the image — so leave them unset here.
# OSM_REVIEWER_REV=
# OSM_REVIEWER_IMAGE=

# The pipeline. `false` turns off the scheduler and every fetch at boot; "run now" still works.
# PIPELINE_ENABLED=true
# Overpass counts and matches the area's existing POIs; Nominatim searches boundaries.
# Both are public instances with usage policies — point them at your own for heavy use.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# The model for sources whose extractor is "model": openai (any OpenAI-compatible
# /chat/completions server) or anthropic. Unset, such a source fails its run.
# LLM_PROVIDER=openai
# LLM_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b-instruct
# LLM_API_KEY=

# Where changesets are uploaded, and the OAuth2 application registered there. The default is
# the dev sandbox, which discards what it is given — set the live server deliberately.
# OSM_URL=https://master.apis.dev.openstreetmap.org
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Periodic SQLite snapshots (better-sqlite3 online backup) into this directory. Unset, no
# backup runs. The SMTP relay for email notifications is set in the Notifications pane.
# BACKUP_DIR=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7

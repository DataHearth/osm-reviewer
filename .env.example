# SQLite database. WAL is on, so the directory must be writable, not just the file.
DATABASE_PATH=./data/osm-reviewer.db

# adapter-node (production build only; `pnpm dev` ignores these).
HOST=0.0.0.0
PORT=3000
# The address reviewers open. Form posts are checked against it, and the session cookie
# is Secure only when it is https.
ORIGIN=http://localhost:3000
# Behind a TLS-terminating proxy, have adapter-node read the scheme from this header,
# or the session cookie is never marked Secure.
# PROTOCOL_HEADER=x-forwarded-proto
# BODY_SIZE_LIMIT=512K

# The first admin, created at boot only while the users table is empty. In dev, the seed
# applies these to the fixture admin instead.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# OpenID Connect sign-in. Off until SSO_ISSUER is set; SSO_ENABLED=false turns it off
# even then. The provider must allow <ORIGIN>/login/callback as a redirect URI.
SSO_ISSUER=
# SSO_ENABLED=true
# The name on the "continue with …" button.
SSO_PROVIDER=SSO
SSO_CLIENT_ID=osm-reviewer
# Sent with HTTP Basic auth. Leave empty for a public client, which PKCE alone protects.
SSO_CLIENT_SECRET=
SSO_SCOPES=openid profile email groups
# Required in the `groups` claim on every SSO sign-in. Empty lets any account at the
# provider in.
SSO_GROUP=osm-reviewers

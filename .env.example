# Copy to .env (or .env.development, which wins for `pnpm dev` and the db scripts).
# Shell variables beat both; a production deployment sets these in the unit, not here.

# SQLite file. Its directory must be writable — WAL puts two more files beside it.
DATABASE_PATH=./data/osm-reviewer.db

# adapter-node, `pnpm build && pnpm start` only. The dev server ignores them.
HOST=0.0.0.0
PORT=3000
# Required behind a proxy or form posts are rejected as cross-origin.
# ORIGIN=https://reviewer.example.org
BODY_SIZE_LIMIT=1M

# Identity provider. Quoted on the login screen and in the diagnostics pane; the SSO
# action is still a stub, so nothing here is contacted and no client secret is read.
# SSO_ENABLED=false hides the button and 404s the action — an account with no local
# password then has no way in.
SSO_ENABLED=true
SSO_PROVIDER=Authelia
SSO_HOST=auth.lan
SSO_ISSUER=https://auth.lan/.well-known/openid-configuration
SSO_CLIENT_ID=candidate-review
SSO_SCOPES=openid profile email groups
SSO_GROUP=osm-reviewers

# The admin account `pnpm db:seed` creates. Read only by the seed, so a change here
# takes effect at the next seed — which deletes every row and starts over. The other
# fixture users stay demo accounts on the fixture password.
SEED_ADMIN_NAME=Antoine Langlois
SEED_ADMIN_EMAIL=antoine@antoine-langlois.net
SEED_ADMIN_PASSWORD=review
